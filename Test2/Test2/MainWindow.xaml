<Window x:Class="Test2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="400" Width="300" Background="#90EE90" WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Border CornerRadius="10" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
            <StackPanel>
                <!-- Avatar -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="60" Height="60" Margin="0,0,0,20">
                    <Ellipse Fill="DarkGreen"/>
                    <TextBlock Text="👤" FontSize="30" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Email TextBox with Placeholder -->
                <Grid Margin="0,10,0,10">
                    <TextBox x:Name="EmailTextBox" Padding="10" TextChanged="EmailTextBox_TextChanged"/>
                    <TextBlock x:Name="EmailPlaceholder" Text="Email ID" Foreground="Gray" IsHitTestVisible="False" 
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>

                <!-- PasswordBox with Placeholder -->
                <Grid Margin="0,10,0,10">
                    <PasswordBox x:Name="PasswordBox" Padding="10" PasswordChanged="PasswordBox_PasswordChanged"/>
                    <TextBlock x:Name="PasswordPlaceholder" Text="Password" Foreground="Gray" IsHitTestVisible="False" 
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>

                <!-- Remember Me & Forgot Password -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,10,0,10">
                    <CheckBox Content="Remember me" Margin="0,0,10,0" />
                    <Button Content="Forgot Password?" Foreground="Blue" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Right" />
                </StackPanel>


                <!-- Login Button -->
                <Button Content="LOGIN" Background="DarkGreen" Foreground="White" Padding="10" BorderBrush="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Border>
        <Button Content="Button" HorizontalAlignment="Left" Margin="205,192,0,0" VerticalAlignment="Top"/>
        <Label Content="Test" HorizontalAlignment="Left" Margin="209,57,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>
